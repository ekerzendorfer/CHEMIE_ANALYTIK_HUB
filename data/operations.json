{
  "schema_version": "0.10.0",
  "operations": [
    {
      "id": "FILTER",
      "name_de": "Filtration",
      "category": "sample_preparation",
      "creates_samples": true,
      "input_requirements": {
        "heterogeneous": true
      },
      "output_roles": [
        "filtrate",
        "filter_residue"
      ]
    },
    {
      "id": "CENTRIFUGE",
      "name_de": "Zentrifugieren",
      "category": "sample_preparation",
      "creates_samples": true,
      "input_requirements": {
        "heterogeneous": true
      },
      "output_roles": [
        "supernatant",
        "sediment"
      ]
    },
    {
      "id": "DISSOLVE_WATER",
      "name_de": "In Wasser lösen",
      "category": "sample_preparation",
      "creates_samples": true,
      "output_roles": [
        "aqueous_solution"
      ]
    },
    {
      "id": "PREPARE_ALIQUOTS",
      "name_de": "Teilproben vorbereiten",
      "category": "sample_preparation",
      "creates_samples": true,
      "output_roles": [
        "ion_analysis_aliquot",
        "photometry_aliquot"
      ]
    },
    {
      "id": "COMPLEX_AMMONIA_EXCESS",
      "name_de": "Mit Ammoniaküberschuss komplexieren",
      "category": "sample_preparation",
      "creates_samples": true,
      "output_roles": [
        "complexed_measurement_solution"
      ]
    },
    {
      "id": "DILUTE",
      "name_de": "Verdünnen",
      "category": "sample_preparation",
      "creates_samples": true,
      "output_roles": [
        "diluted_sample"
      ]
    },
    {
      "id": "DISTILL",
      "name_de": "Destillieren",
      "category": "separation",
      "creates_samples": true,
      "external_app": "DESTILLATION_LAB",
      "output_roles": [
        "fraction_1",
        "fraction_2",
        "fraction_3",
        "residue"
      ],
      "acceptance_policy": {
        "minimum_quality_score": 3,
        "score_max": 5,
        "repeat_until_accepted": true,
        "note_de": "0–2 Sterne: neuer Run empfohlen und keine Rückgabe. Ab 3 Sternen können die erzeugten Fraktionen übernommen werden."
      }
    },
    {
      "id": "EXTRACT_LLE",
      "name_de": "Flüssig-Flüssig-Extraktion",
      "category": "separation",
      "creates_samples": true,
      "status": "reserved",
      "output_roles": [
        "aqueous_phase",
        "organic_phase"
      ]
    },
    {
      "id": "ISOLATE_RESIDUE_SOLID",
      "name_de": "Rückstand abkühlen und Feststoff isolieren",
      "category": "sample_preparation",
      "creates_samples": true,
      "output_roles": [
        "unknown_organic_solid"
      ],
      "note_de": "Verbliebene flüchtige Komponenten werden entfernt; der nichtflüchtige organische Rückstand wird als Feststoff für die qualitative Voranalyse bereitgestellt."
    }
  ]
}
